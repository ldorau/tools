#!/bin/bash

# echo "<$1>"

FILE=$(echo "$1" | cut -d: -f1)
LINE=$(echo "$1" | cut -s -d: -f2)
[ "$LINE" != "" ] && VLINE=+$LINE

for file in $(find -name "$FILE"); do
	if [ "$LINE" != "" ]; then
		MAX=$(cat $file | wc -l)
		[ $LINE -gt $MAX ] && continue
	fi
	echo "$ vim $file $VLINE"
	vim $file $VLINE
done
