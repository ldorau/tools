#!/bin/bash
FILE=./src/test/pmem_is_pmem/out1.log.match
CONFIG=./src/test/testconfig.sh
TMP=/tmp/tmp-$$-file-$$

if [ "$1" != "ON" -a "$1" != "OFF" ]; then
	echo "Usage: $0 <ON|OFF>"
	exit 1
fi

LINES=`cat $FILE | wc -l`
if [ $LINES -ne 4 ]; then
	echo "Error: bad format of file: $FILE"
	exit 1
fi

if [ "$1" == "ON" ]; then
	sed -i 's/^#PMEM_FS_DIR/PMEM_FS_DIR/g' $CONFIG
else
	sed -i 's/^PMEM_FS_DIR/#PMEM_FS_DIR/g' $CONFIG
fi

head -n2 $FILE > $TMP
if [ "$1" == "ON" ]; then
        echo "0" >> $TMP
else
        echo "1" >> $TMP
fi
tail -n1 $FILE >> $TMP
mv $TMP $FILE

STATUS=`git status --porcelain | grep -v '??'`
if [ "$STATUS" != "" ]; then
	git commit -a --amend
fi


