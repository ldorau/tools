#!/bin/bash
# find . -name "*" | xargs grep -e "$1" | cut -d: -f1 | uniq

if [ "$1" == "-v" ]; then
	VERBOSE=1
	shift
fi

if [ "$2" != "" ]; then
	MASK=$2
else
	MASK="*"
fi

if [ "$VERBOSE" == "1" ]; then
	echo "Looking for the string \"$1\" in files \"$MASK\"..."
	echo "-----"
fi

find . -name "$MASK" -print0 | xargs -0 grep -nH -e "$1" 2>/dev/null | grep -v "/.git/" | grep -v "Binary file " | cut -d: -f1 | uniq

if [ "$VERBOSE" == "1" ]; then
	echo "-----"
	echo "Strings \"$1\" in files \"$MASK\""
fi


