#!/bin/bash

ORIGIN=$(git-get-origin)
UPSTREAM=$(git-get-upstream)

if [ "$1" == "" ]; then
        echo "ERROR: no branch name given"
        exit 0;
fi

for branch in $*; do
	prefix=$(echo $branch | cut -d'/' -f1)
	if [ "$prefix" != "remotes" ]; then
		echo "$ git branch -D $branch"
		git branch -D $branch
		IS_REMOTE=$(git branch -a | grep "remotes/$ORIGIN/$branch")
		[ "$IS_REMOTE" != "" ] \
			&& echo "$ git-push-secure $ORIGIN :$branch" \
			&& git-push-secure $ORIGIN :$branch || true
	        [ $(git log -1 $ORIGIN/$branch 2>/dev/null | wc -l) -gt 0 ] && git branch -r -d $ORIGIN/$branch || true
	else
		remote=$(echo $branch | cut -d'/' -f2)
		[ "$remote" = "$UPSTREAM" ] && continue
		branch=$(echo $branch | cut -d'/' -f3)
		echo "$ git-push-secure $remote :$branch"
		git-push-secure $remote :$branch || true
	fi
done
# git remote prune $ORIGIN
