#!/usr/bin/env bash
#
# cleanup-merged-branches.sh
#
# Checks all local git branches and, for each one that has an associated
# GitHub pull request that has already been MERGED, deletes the branch
# both locally and on the remote (if it still exists there).
#
# Usage:
#   ./cleanup-merged-branches.sh [--dry-run] [--remote <name>] [--yes]
#
# Options:
#   --dry-run         Show what would be deleted without deleting anything.
#   --remote <name>   Remote to check/delete branches on (default: origin).
#   --yes             Skip the confirmation prompt before deleting.
#
# Requirements: git, gh (GitHub CLI, authenticated), jq

set -euo pipefail

REMOTE="origin"
DRY_RUN=0
ASSUME_YES=0
PROTECTED_BRANCHES=("main" "master" "sycl" "develop")

usage() {
    grep '^#' "$0" | sed -e 's/^#//' -e '1d'
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --remote) REMOTE="$2"; shift 2 ;;
        --yes) ASSUME_YES=1; shift ;;
        -h|--help) usage ;;
        *) echo "Unknown option: $1" >&2; usage ;;
    esac
done

command -v git >/dev/null 2>&1 || { echo "Error: git is required." >&2; exit 1; }
command -v gh  >/dev/null 2>&1 || { echo "Error: gh (GitHub CLI) is required." >&2; exit 1; }
command -v jq  >/dev/null 2>&1 || { echo "Error: jq is required." >&2; exit 1; }

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "Error: not inside a git repository." >&2
    exit 1
}

gh auth status >/dev/null 2>&1 || {
    echo "Error: gh is not authenticated. Run 'gh auth login' first." >&2
    exit 1
}

is_protected() {
    local branch="$1" p
    for p in "${PROTECTED_BRANCHES[@]}"; do
        [[ "$branch" == "$p" ]] && return 0
    done
    return 1
}

current_branch=$(git rev-parse --abbrev-ref HEAD)

echo "Fetching latest state from remote '$REMOTE' (pruning stale refs)..."
git fetch --prune "$REMOTE" --force

mapfile -t branches < <(git for-each-ref --format='%(refname:short)' refs/heads/)

to_delete=()

for branch in "${branches[@]}"; do
    if is_protected "$branch"; then
        echo "SKIP  (protected)      $branch"
        continue
    fi
    if [[ "$branch" == "$current_branch" ]]; then
        echo "SKIP  (checked out)    $branch"
        continue
    fi

    # Look up the PR associated with this branch's head, if any.
    pr_json=$(gh pr list --head "$branch" --state all \
        --json number,state,mergedAt --limit 1 2>/dev/null || echo '[]')

    if [[ "$pr_json" == "[]" || -z "$pr_json" ]]; then
        echo "SKIP  (no PR found)    $branch"
        continue
    fi

    state=$(echo "$pr_json" | jq -r '.[0].state')
    number=$(echo "$pr_json" | jq -r '.[0].number')

    if [[ "$state" == "MERGED" ]]; then
        echo "MERGED (PR #$number)    $branch"
        to_delete+=("$branch:$number")
    else
        echo "SKIP  (PR #$number $state) $branch"
    fi
done

if [[ ${#to_delete[@]} -eq 0 ]]; then
    echo "No branches to delete."
    exit 0
fi

echo
echo "The following branches point to merged PRs and will be deleted"
echo "(locally, and on remote '$REMOTE' if present):"
for entry in "${to_delete[@]}"; do
    echo "  - ${entry%%:*} (PR #${entry##*:})"
done

if [[ $DRY_RUN -eq 1 ]]; then
    echo
    echo "Dry run: no branches were deleted."
    exit 0
fi

if [[ $ASSUME_YES -ne 1 ]]; then
    read -r -p $'\nProceed with deletion? [y/N] ' reply
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
fi

for entry in "${to_delete[@]}"; do
    branch="${entry%%:*}"

    echo "Deleting local branch: $branch"
    git branch -D "$branch"

    if git ls-remote --exit-code --heads "$REMOTE" "$branch" >/dev/null 2>&1; then
        echo "Deleting remote branch: $REMOTE/$branch"
        git push "$REMOTE" --delete "$branch"
    else
        echo "Remote branch $REMOTE/$branch does not exist, skipping remote delete."
    fi
done

echo "Done."
