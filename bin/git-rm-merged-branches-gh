#!/usr/bin/env bash
#
# git-rm-merged-branches-gh
#
# Checks all local git branches and, for each one that has an associated
# GitHub pull request that has already been MERGED, deletes the branch
# both locally and on the remote (if it still exists there).
#
# A branch is deleted only if:
#   - the merged PR was opened from this branch of the <remote> repository
#     (not from a branch with the same name in another fork),
#   - there is no open PR from this branch,
#   - the branch does not contain commits that are not in the merged PR.
# The remote branch is deleted only on your own fork (owned by the gh user)
# and only if it does not contain commits that are not in the merged PR.
#
# Usage:
#   git-rm-merged-branches-gh [--dry-run] [--remote <name>] [--yes]
#
# Options:
#   --dry-run         Show what would be deleted without deleting anything.
#   --remote <name>   Remote the branches were pushed to (default: origin).
#   --yes             Skip the confirmation prompt before deleting.
#
# Requirements: git, gh (GitHub CLI, authenticated), jq

set -euo pipefail

REMOTE="origin"
DRY_RUN=0
ASSUME_YES=0
PROTECTED_BRANCHES=("main" "master" "sycl" "develop")

usage() {
    grep '^#' "$0" | sed -e 's/^#//' -e '1d'
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=1; shift ;;
        --remote) REMOTE="$2"; shift 2 ;;
        --yes) ASSUME_YES=1; shift ;;
        -h|--help) usage ;;
        *) echo "Unknown option: $1" >&2; usage ;;
    esac
done

command -v git >/dev/null 2>&1 || { echo "Error: git is required." >&2; exit 1; }
command -v gh  >/dev/null 2>&1 || { echo "Error: gh (GitHub CLI) is required." >&2; exit 1; }
command -v jq  >/dev/null 2>&1 || { echo "Error: jq is required." >&2; exit 1; }

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "Error: not inside a git repository." >&2
    exit 1
}

gh auth status >/dev/null 2>&1 || {
    echo "Error: gh is not authenticated. Run 'gh auth login' first." >&2
    exit 1
}

is_protected() {
    local branch="$1" p
    for p in "${PROTECTED_BRANCHES[@]}"; do
        [[ "$branch" == "$p" ]] && return 0
    done
    case "$branch" in
        v[0-9]*|stable-*|devel-*|release*|*.x|gh-pages|man-pages) return 0 ;;
    esac
    return 1
}

# true if commit $1 is the same as commit $2 or it is contained in it
is_contained_in() {
    local commit="$1" pr_commit="$2"
    [[ -n "$commit" && -n "$pr_commit" ]] || return 1
    [[ "$commit" == "$pr_commit" ]] && return 0
    git cat-file -e "${pr_commit}^{commit}" 2>/dev/null || return 1
    git merge-base --is-ancestor "$commit" "$pr_commit" 2>/dev/null
}

remote_url=$(git remote get-url "$REMOTE" 2>/dev/null) || {
    echo "Error: remote '$REMOTE' does not exist." >&2
    exit 1
}
# git@github.com:owner/repo.git, https://github.com/owner/repo(.git), ssh://git@github.com/owner/repo.git
remote_repo=$(echo "$remote_url" | sed -E 's#^(git@[^:]+:|[a-z+]+://([^@/]+@)?[^/]+/)##; s#\.git$##; s#/$##')
REMOTE_OWNER="${remote_repo%%/*}"
REMOTE_NAME="${remote_repo#*/}"
if [[ -z "$REMOTE_OWNER" || -z "$REMOTE_NAME" || "$remote_repo" != */* ]]; then
    echo "Error: cannot get the GitHub owner/repo of remote '$REMOTE' ($remote_url)." >&2
    exit 1
fi

GH_USER=$(gh api user --jq .login)
DELETE_ON_REMOTE=1
if [[ "$REMOTE_OWNER" != "$GH_USER" ]]; then
    DELETE_ON_REMOTE=0
    echo "Remote '$REMOTE' ($REMOTE_OWNER/$REMOTE_NAME) is not your fork ($GH_USER):"
    echo "branches will be deleted only locally, never on '$REMOTE'."
fi

current_branch=$(git rev-parse --abbrev-ref HEAD)

echo "Fetching latest state from remote '$REMOTE' (pruning stale refs)..."
git fetch --prune "$REMOTE" --force

mapfile -t branches < <(git for-each-ref --format='%(refname:short)' refs/heads/)

to_delete=()

for branch in "${branches[@]}"; do
    if is_protected "$branch"; then
        echo "SKIP  (protected)      $branch"
        continue
    fi
    if [[ "$branch" == "$current_branch" ]]; then
        echo "SKIP  (checked out)    $branch"
        continue
    fi

    # All PRs from a branch with this name (in any fork) ...
    if ! pr_json=$(gh pr list --head "$branch" --state all --limit 100 \
            --json number,state,headRepositoryOwner,headRepository 2>&1); then
        echo "SKIP  (gh error: $pr_json) $branch"
        continue
    fi
    # ... but only the ones opened from this branch of $REMOTE_OWNER/$REMOTE_NAME.
    prs=$(echo "${pr_json:-[]}" | jq -r --arg owner "$REMOTE_OWNER" --arg repo "$REMOTE_NAME" '
        .[] | select(.headRepositoryOwner.login == $owner and .headRepository.name == $repo)
            | "\(.number) \(.state)"')

    if [[ -z "$prs" ]]; then
        echo "SKIP  (no PR found)    $branch"
        continue
    fi

    open_pr=$(echo "$prs" | awk '$2 == "OPEN" { print $1; exit }')
    if [[ -n "$open_pr" ]]; then
        echo "SKIP  (PR #$open_pr OPEN) $branch"
        continue
    fi

    local_commit=$(git rev-parse "refs/heads/$branch")
    merged_pr=""
    merged_commit=""
    while read -r number state; do
        [[ "$state" == "MERGED" ]] || continue
        # the last commit of the PR (the PR's head when it was merged)
        pr_commit=$(gh pr view "$number" --json commits --jq '.commits[-1].oid' </dev/null 2>/dev/null || true)
        if is_contained_in "$local_commit" "$pr_commit"; then
            merged_pr="$number"
            merged_commit="$pr_commit"
            break
        fi
        [[ -z "$merged_pr" ]] && merged_pr="-$number"
    done <<< "$prs"

    if [[ -z "$merged_pr" ]]; then
        echo "SKIP  (PR #$(echo "$prs" | head -n1 | cut -d' ' -f1) $(echo "$prs" | head -n1 | cut -d' ' -f2)) $branch"
        continue
    fi
    if [[ "$merged_pr" == -* ]]; then
        echo "SKIP  (PR #${merged_pr#-} MERGED, but the branch has new commits) $branch"
        continue
    fi

    echo "MERGED (PR #$merged_pr)    $branch"
    to_delete+=("$branch:$merged_pr:$merged_commit")
done

if [[ ${#to_delete[@]} -eq 0 ]]; then
    echo "No branches to delete."
    exit 0
fi

echo
echo "The following branches point to merged PRs and will be deleted"
if [[ $DELETE_ON_REMOTE -eq 1 ]]; then
    echo "(locally, and on remote '$REMOTE' if present):"
else
    echo "(only locally):"
fi
for entry in "${to_delete[@]}"; do
    IFS=: read -r branch number _ <<< "$entry"
    echo "  - $branch (PR #$number)"
done

if [[ $DRY_RUN -eq 1 ]]; then
    echo
    echo "Dry run: no branches were deleted."
    exit 0
fi

if [[ $ASSUME_YES -ne 1 ]]; then
    read -r -p $'\nProceed with deletion? [y/N] ' reply
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
fi

for entry in "${to_delete[@]}"; do
    IFS=: read -r branch number merged_commit <<< "$entry"

    echo "Deleting local branch: $branch"
    if ! git branch -D "$branch"; then
        echo "Warning: cannot delete local branch $branch (checked out in another worktree?), skipping." >&2
        continue
    fi

    [[ $DELETE_ON_REMOTE -eq 1 ]] || continue

    remote_commit=$(git ls-remote --heads "$REMOTE" "refs/heads/$branch" | cut -f1)
    if [[ -z "$remote_commit" ]]; then
        echo "Remote branch $REMOTE/$branch does not exist, skipping remote delete."
    elif ! is_contained_in "$remote_commit" "$merged_commit"; then
        echo "Remote branch $REMOTE/$branch has commits that are not in PR #$number, skipping remote delete."
    else
        echo "Deleting remote branch: $REMOTE/$branch"
        git push "$REMOTE" --delete "$branch"
    fi
done

echo "Done."
