#!/bin/bash

if [ "$1" == "" ]; then
        echo "usage: $0 <string> [file-pattern]"
        echo "Remove lines <string> in files [file-pattern]"
        exit 0;
fi

GIT_MOVED=0
if [ -d .git ]; then
	TEMP_GIT="../.temp-dir-git"
	rm -rf $TEMP_GIT
	mv .git $TEMP_GIT
	GIT_MOVED=1
fi

[ "$2" == "" ] && FILES="*" || FILES="$2"

echo "Removing lines $1 in files $FILES ..."
echo "find . -name '$FILES' -type f -print0 | xargs -0 sed -i '/$1/d'"
find . -name "$FILES" -type f -print0 | xargs -0 sed -i "/$1/d"

if [ $GIT_MOVED -eq 1 ]; then
	mv -f $TEMP_GIT .git
fi

