#!/bin/bash

CMD="commands.txt"
L_CMD="/home/loggedin/logs/$CMD"

OP=$1
shift

case "$OP" in
u)
	echo "update" >> $CMD
	;;
t)
	echo "reset $1" >> $CMD
	;;
h)
	echo "hibernate $1" >> $CMD
	;;
r)
	echo "restart" >> $CMD
	;;
b)
	echo "break" >> $CMD
	;;
db)
	echo "disable-break" >> $CMD
	;;
sb)
	echo "setUnlockQuotaEnabled $1" >> $CMD
	;;
dc)
	echo "download-config" >> $CMD
	;;
uc)
	echo "upload-config" >> $CMD
	;;
p)
	sudo cat $L_CMD
	exit 0
	;;
c)
	sudo rm $L_CMD
	sudo touch $L_CMD
	sudo chown loggedin:loggedin $L_CMD
	sudo cat $L_CMD
	exit 0
	;;
"")
	echo "u  - update"
	echo "t  - reset time (arg: \$1)"
	echo "h  - hibernate (arg: \$1)"
	echo "r  - restart"
	echo "b  - break"
	echo "db - disable-break"
	echo "sb - set-break [t|f] (setUnlockQuotaEnabled [true|false])"
	echo "dc - download-config"
	echo "uc - upload-config"
	echo "p  - print the cmd file"
	echo "c  - clear the cmd file"
	exit 0
	;;
*)
	echo "Error: unknown op: $OP"
	exit 1
	;;
esac

echo "Added:"
cat ./$CMD | sudo tee -a $L_CMD
echo
echo "CMD file:"
sudo cat $L_CMD
sudo chown loggedin:loggedin $L_CMD
rm ./$CMD
