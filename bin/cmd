#!/bin/bash

CMD="commands.txt"
L_CMD="/home/loggedin/logs/$CMD"

OP=$1
shift

case "$OP" in
u)
	echo "update" >> $CMD
	;;
t)
	echo "reset $1" >> $CMD
	;;
r)
	echo "restart" >> $CMD
	;;
b)
	echo "break" >> $CMD
	;;
db)
	echo "disable-break" >> $CMD
	;;
sb)
	echo "setUnlockQuotaEnabled $1" >> $CMD
	;;
c)
	sudo rm $L_CMD
	sudo touch $L_CMD
	sudo chown loggedin:loggedin $L_CMD
	sudo cat $L_CMD
	exit 0
	;;
p)
	sudo cat $L_CMD
	exit 0
	;;
h|"")
	echo "u - update"
	echo "r - restart"
	echo "t - reset time (arg: \$1)"
	echo "b - break"
	echo "p - print the CMD file"
	echo "c - clear the CMD file"
	echo "h - this help"
	exit 0
	;;
*)
	echo "Error: unknown op: $OP"
	exit 1
	;;
esac

echo "Added:"
cat ./$CMD | sudo tee -a $L_CMD
echo
echo "CMD file:"
sudo cat $L_CMD
sudo chown loggedin:loggedin $L_CMD
rm ./$CMD
