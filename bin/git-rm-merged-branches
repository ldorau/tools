#!/bin/bash
#
# Removes branches that are already merged into the default branches
# (their tip commit is contained in $ORIGIN/<default> or $UPSTREAM/<default>):
# - $ORIGIN/* branches (on the server) and the local branches with the same name,
# - local branches,
# - $UPSTREAM/* and other remote-tracking refs (only locally, never on the server).
# Default, release and not merged branches are never removed.
#

ORIGIN=$(git-get-origin)
UPSTREAM=$(git-get-upstream)

DEFAULT_BRANCH=$(git-get-default-branch)
EXCLUSIONS="$(git-get-default-branches | xargs)"

function in_exclusions() {
	local YES=0
	local NO=1
	local BRANCH=$1
	local ex
	[ "$EXCLUSIONS" == "" ] && return $NO
	for ex in $EXCLUSIONS; do
		[ "$ex" == "$BRANCH" ] && return $YES
	done
	return $NO
}

function verify_branch() {
	# remove stable-[0-9].[0-9], devel-[0-9].[0-9] and man-pages
	local REST=$(echo $1 \
		| sed "s/$DEFAULT_BRANCH//g" \
		| sed 's/man-pages//g' \
		| sed 's/stable-[0-9].[0-9]//g' \
		| sed 's/devel-[0-9].[0-9]//g' \
		)
	echo $REST
}

# default, release and other long-lived branches - never remove them
function is_protected() {
	local br=$1
	in_exclusions $br && return 0
	[ "$(verify_branch $br)" == "" ] && return 0
	case "$br" in
	HEAD|main|master|develop|sycl|gh-pages|man-pages) return 0 ;;
	v[0-9]*|stable-*|devel-*|release*|*.x) return 0 ;;
	esac
	return 1
}

function branch_exists() {
	git log -1 $1 >/dev/null 2>&1
}

function local_branch_exists() {
	git show-ref --verify --quiet refs/heads/$1
}

function get_commit() {
	git log -1 --pretty=format:%H $1 --
}

ALL_COMMITS=/tmp/all-commits-$$
rm -f $ALL_COMMITS
touch $ALL_COMMITS

# tformat: every commit (also the last one) has to be in a separate line
for b in $(git-get-default-branches); do
	branch_exists $ORIGIN/$b && git log --pretty=tformat:%H $ORIGIN/$b -- >> $ALL_COMMITS
	[ "$UPSTREAM" != "" ] && branch_exists $UPSTREAM/$b && \
		git log --pretty=tformat:%H $UPSTREAM/$b -- >> $ALL_COMMITS
done

if [ ! -s $ALL_COMMITS ]; then
	echo "ERROR: no default branches found - nothing can be verified as merged"
	rm -f $ALL_COMMITS
	exit 1
fi

# the tip commit of the given branch is contained in one of the default branches
function is_merged() {
	local commit=$(get_commit $1)
	[ "$commit" == "" ] && return 1
	grep -q -x "$commit" $ALL_COMMITS
}

REMOTEB=$(git branch -r | grep -e "^ *$ORIGIN/" | grep -v -e "HEAD" -e " -> ")
for b in $REMOTEB; do
	br=$(echo $b | cut -d/ -f2-)
	is_protected $br && continue
	is_merged $b || continue

	echo Removing remote branch remotes/$b ...
	git-push-secure $ORIGIN :$br
	echo

	if local_branch_exists $br && is_merged $br; then
		echo Removing local branch $br ...
		git branch -D $br
		echo
	fi
done

LOCALB=$(git for-each-ref --format='%(refname:short)' refs/heads/)
for b in $LOCALB; do
	is_protected $b && continue
	is_merged $b || continue

	echo Removing local branch $b ...
	git branch -D $b
	echo
done

# remove merged "remotes/$UPSTREAM/" branches (only remote-tracking refs)
if [ "$UPSTREAM" != "" ]; then
	REMOTEB=$(git branch -r | grep -e "^ *$UPSTREAM/" | grep -v -e "HEAD" -e " -> ")
	for b in $REMOTEB; do
		br=$(echo $b | cut -d/ -f2-)
		is_protected $br && continue
		is_merged $b || continue
		local_branch_exists $br && continue
		branch_exists $ORIGIN/$br && continue
		git branch -r -d $b
	done
fi

# remove merged remote-tracking refs of other remotes (not $ORIGIN nor $UPSTREAM)
REMOTEB=$(git branch -r | grep -v -e "^ *$ORIGIN/" -e "HEAD" -e " -> ")
[ "$UPSTREAM" != "" ] && REMOTEB=$(echo "$REMOTEB" | grep -v -e "^ *$UPSTREAM/")
for b in $REMOTEB; do
	br=$(echo $b | cut -d/ -f2-)
	is_protected $br && continue
	is_merged $b || continue
	git branch -r -d $b
done

rm -f $ALL_COMMITS
