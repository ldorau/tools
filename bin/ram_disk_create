#!/bin/bash

if [ "$1" == "" ]; then
	SIZE=8G
else
	SIZE=$1
fi

if [ "`mount | grep "\/tmpfs"`" == "" ]; then
	sudo mount -t tmpfs -o size=$SIZE tmpfs /tmpfs
	if [ $? -eq 0 ]; then
		echo "RAM disk mounted at /tmpfs:"
		mount | grep "\/tmpfs"
	else
		echo "RAM disk mounting FAILED!"
	fi
else
	SIZE=$(mount | grep "\/tmpfs" | grep tmpfs | cut -d= -f2 | cut -dk -f1)
	SIZE=$(($SIZE / (1024 * 1024)))
	echo "RAM disk is already mounted (size ${SIZE}G):"
	mount | grep "\/tmpfs"
fi

mkdir -p /tmpfs/test/remote
