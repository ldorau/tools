#!/bin/bash

SCRIPT=$1
LOG=$2

if [ ! -x "$SCRIPT" ]; then
	echo "Error: script \"$SCRIPT\" does not exist!"
	exit 1
fi

if [ ! -f "$LOG" ]; then
	echo "Error: log \"$LOG\" does not exist!"
	exit 1
fi

BSCRIPT=$(basename $SCRIPT)
BLOG=$(basename $LOG)

FILE_LINES=/tmp/nlines-${BSCRIPT}-${BLOG}
touch ${FILE_LINES}

NLINES=$(cat ${FILE_LINES})
[ "$NLINES" = "" ] && NLINES=0

NEW=$(wc -l $LOG | cut -d' ' -f1)
echo $NEW > $FILE_LINES
[ $NEW -lt $NLINES ] && NLINES=0

tail --lines=+${NLINES} $LOG
