#!/bin/bash
#
# Usage: CR-update [-f]
#   -f  force re-installing the latest version even if it is already installed

FORCE=false
case "$1" in
	"") ;;
	-f) FORCE=true ;;
	*) echo "Usage: $(basename "$0") [-f]" >&2; exit 1 ;;
esac

cd ~/work/compute-runtime
git fetch --tags --force
# LATEST=$(git tag | tail -n1)
LATEST_1=$(git tag | tail -n1 | cut -d. -f1-3)
LATEST_2=$(git tag | grep -e "$LATEST_1" | cut -d. -f4 | sort -n | tail -n1)
LATEST="${LATEST_1}.${LATEST_2}"
mkdir -p ./build
CURRENT_FILE="./build/.version"
touch $CURRENT_FILE
CURRENT=$(cat $CURRENT_FILE)
[ "$CURRENT" = "" ] && CURRENT="prev"

if [ "$LATEST" = "$CURRENT" ]; then
	if [ "$FORCE" = false ]; then
		echo "L0 CR driver is up-to-date ($CURRENT). No update needed (use -f to force re-installing it)."
		exit 0
	fi
	echo "L0 CR driver is up-to-date ($CURRENT), but forcing re-installing it (-f) ..."
fi

ARCHIVE=~/work/compute-runtime/build-$CURRENT
[ -e "$ARCHIVE" ] && ARCHIVE="${ARCHIVE}-$(date +%Y%m%d-%H%M%S)"
echo "Archive the current L0 CR $CURRENT build to $ARCHIVE ..."
mv ~/work/compute-runtime/build "$ARCHIVE"

echo "Updating L0 CR driver to $LATEST ..."
cd ~/work/compute-runtime
mkdir -p ./build
touch $CURRENT_FILE
echo "$LATEST" > $CURRENT_FILE
git reset --hard $LATEST

echo "Building L0 CR Debug ..."
echo "$ ~/work/mytools/bin/build_cr.sh $LATEST ~/work/compute-runtime/build Debug"
~/work/mytools/bin/build_cr.sh $LATEST ~/work/compute-runtime/build "Debug"

if [ $? -ne 0 ]; then
	echo
	echo "ERROR: build FAILED, restoring the previous $CURRENT build"
	echo "$CURRENT" > $CURRENT_FILE
	rm -rf ~/work/compute-runtime/build
	mv "$ARCHIVE" ~/work/compute-runtime/build
fi

# lit enables the "ocloc" feature of SYCL E2E tests only if an executable
# named exactly "ocloc" is found in PATH, but compute-runtime installs a
# versioned one (e.g. ocloc-26.35.1), so keep ~/bin/ocloc pointing at it.
OCLOC=$(ls ~/work/compute-runtime/build/bin/ocloc-* 2>/dev/null | sort -V | tail -n1)
if [ -n "$OCLOC" ]; then
	mkdir -p ~/bin
	ln -sf "$OCLOC" ~/bin/ocloc
	echo "Updated the ~/bin/ocloc link -> $OCLOC"
else
	echo "WARNING: no ocloc-* found in ~/work/compute-runtime/build/bin, ~/bin/ocloc not updated"
fi
