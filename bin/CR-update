#!/bin/bash

cd ~/work/compute-runtime
git fetch --tags --force
# LATEST=$(git tag | tail -n1)
LATEST_1=$(git tag | tail -n1 | cut -d. -f1-3)
LATEST_2=$(git tag | grep -e "$LATEST_1" | cut -d. -f4 | sort -n | tail -n1)
LATEST="${LATEST_1}.${LATEST_2}"
mkdir -p ./build
CURRENT_FILE="./build/.version"
touch $CURRENT_FILE
CURRENT=$(cat $CURRENT_FILE)
[ "$CURRENT" = "" ] && CURRENT="prev"

[ "$LATEST" = "$CURRENT" ] && echo "L0 CR driver is up-to-date ($CURRENT). No update needed." && exit 0

echo "Archive the current L0 CR $CURRENT build ..."
mv ~/work/compute-runtime/build ~/work/compute-runtime/build-$CURRENT

echo "Updating L0 CR driver to $LATEST ..."
cd ~/work/compute-runtime
mkdir -p ./build
touch $CURRENT_FILE
echo "$LATEST" > $CURRENT_FILE
git reset --hard $LATEST

echo "Building L0 CR Debug ..."
echo "$ ~/work/mytools/bin/build_cr.sh $LATEST ~/work/compute-runtime/build Debug"
~/work/mytools/bin/build_cr.sh $LATEST ~/work/compute-runtime/build "Debug"

if [ $? -ne 0 ]; then
	echo
	echo "ERROR: build FAILED, restoring the previous $CURRENT build"
	echo "$CURRENT" > $CURRENT_FILE
	rm -rf ~/work/compute-runtime/build
	mv ~/work/compute-runtime/build-$CURRENT ~/work/compute-runtime/build
fi
