#!/bin/bash

function update_repo() {
	cd $1
	git fetch --all
	if git status | grep -q -e "modified:"; then
		echo "Error: directory $1 is not clean:"
		git status
		exit 1
	fi
	git reset --hard origin/$(git-get-default-branch)
}


TOOLS_BIN=$HOME/work/tools/bin
MYTOOLS_BIN=$HOME/work/mytools/bin

[ ! -d $TOOLS_BIN ] && echo "Error: directory not found: $TOOLS_BIN" && exit 1

GET_FILES=$HOME/work/mytools/bin/tools-get-files

if [ ! -x $GET_FILES ]; then
	echo "No $GET_FILES script found!"
	exit 1
fi

update_repo $MYTOOLS_BIN
update_repo $TOOLS_BIN

for file in $($GET_FILES); do
	MY_TOOLS=$HOME/work/mytools/bin/$file
	PUB_TOOLS=$HOME/work/tools/bin/$file
	if [ -f $MY_TOOLS ]; then
		if [ -f $PUB_TOOLS ]; then
			[ $MY_TOOLS -nt $PUB_TOOLS ] && cp -u -v $MY_TOOLS $PUB_TOOLS
		else
			cp -v $MY_TOOLS $PUB_TOOLS
		fi
	else
		rm -f $PUB_TOOLS
	fi
done

git-auto-push $HOME/work/tools main
tools-get-files-verify
