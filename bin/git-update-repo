#!/bin/bash

function update_repo() {
	cd $HOME/work/$1/
	BRANCH=$(git-get-current-branch)
	echo "================"
	echo "Updating repo >>> $1 <<<:"
	git fetch --all
	git reset --hard origin/$BRANCH
	git log --oneline -3
	echo "^^^^^^^^^^^^^^^^"
}

if [ "$1" = "" ]; then
	echo "Error: no repo given!"
	exit 1
fi

if [ ! -d $HOME/work/$1 ]; then
	echo "Error: directory $HOME/work/$1 does not exist!"
	exit 1
fi

update_repo $1
